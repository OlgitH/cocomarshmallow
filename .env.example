DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_HOST='127.0.0.1' # Use if you encounter mysqli 2002 / socket connection issues
# DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# --- Cocomarshmallow Books integrations (placeholders: add real values later) ---
# Stripe (WooCommerce Stripe Gateway). Leave blank until you have keys.
STRIPE_TEST_MODE='yes'
STRIPE_TEST_PUBLISHABLE_KEY='pk_test_REPLACE_ME'
STRIPE_TEST_SECRET_KEY='sk_test_REPLACE_ME'
STRIPE_TEST_WEBHOOK_SECRET='whsec_REPLACE_ME'
STRIPE_PUBLISHABLE_KEY='pk_live_REPLACE_ME'
STRIPE_SECRET_KEY='sk_live_REPLACE_ME'
STRIPE_WEBHOOK_SECRET='whsec_REPLACE_ME'

# Outgoing email (contact form + WooCommerce emails). Leave SMTP_HOST blank to use PHP mail().
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURE='tls'
SMTP_USER=''
SMTP_PASSWORD=''
MAIL_FROM_ADDRESS='hello@cocomarshmallowbooks.co.uk'
MAIL_FROM_NAME='Cocomarshmallow Books'
CONTACT_FORM_RECIPIENT='hello@cocomarshmallowbooks.co.uk'
